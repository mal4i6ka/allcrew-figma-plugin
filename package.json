{
  "name": "allcrew-figma-workspace-plugin",
  "version": "1.4.0",
  "private": true,
  "description": "AllCrew Figma Workspace: local-first design tokens, code export, MCP, and agent-driven Figma workflows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mal4i6ka/allcrew-figma-plugin.git"
  },
  "homepage": "https://github.com/mal4i6ka/allcrew-figma-plugin#readme",
  "bugs": {
    "url": "https://github.com/mal4i6ka/allcrew-figma-plugin/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "figma",
    "design-tokens",
    "mcp",
    "codegen",
    "design-system"
  ],
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "package": "node package.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test \"src/*.test.ts\" \"src/agent/*.test.ts\" \"src/modules/*.test.ts\" \"src/canvas/*.test.ts\" \"src/targets/django/**/*.test.ts\" \"src/targets/design-md/*.test.ts\" \"src/targets/react/*.test.ts\" \"src/targets/tauri/*.test.ts\" \"src/targets/ds-tools/**/*.test.ts\" \"src/utils/**/*.test.ts\" \"src/tokens/**/*.test.ts\" \"agent/*.test.mjs\""
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.139.0",
    "esbuild": "^0.28.1",
    "jszip": "^3.10.1",
    "typescript": "^6.0.3"
  }
}
