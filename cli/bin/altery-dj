#!/usr/bin/env python3
"""Symlink-friendly launcher: `ln -s <repo>/cli/bin/altery-dj /usr/local/bin/altery-dj`.
realpath() resolves the symlink back here, so the altery_dj package next to this script is
importable without any installation. (`pipx install -e cli/` is the alternative.)"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from altery_dj.cli import main  # noqa: E402

sys.exit(main())
